PORT=3000
STORE_NAME=S&R Pasabuy PH
# 반드시 바꾸세요 (쿠키 서명용 랜덤 문자열)
SESSION_SECRET=change-me
# 관리자 페이지(/admin) 로그인. 비밀번호가 비어 있으면 관리자 페이지 비활성화
ADMIN_USER=admin
ADMIN_PASSWORD=

# 상품 수집 방식: mock(샘플 데이터) | sitemap(사이트맵+JSON-LD) | shopify(/products.json)
SCRAPER_ADAPTER=mock
SNR_BASE_URL=https://www.snrshopping.com
# 비워두면 robots.txt → /sitemap.xml 순서로 자동 탐색
SNR_SITEMAP_URL=
# 사이트맵 URL 중 상품 페이지만 고르는 정규식 (경로 기준)
SNR_PRODUCT_URL_PATTERN=/products?/|/p/|product
# 요청 간 대기(ms) — S&R 서버에 부담을 주지 않도록 너무 낮추지 마세요
SNR_REQUEST_DELAY_MS=1500
# 0 = 제한 없음 (테스트할 때 20 정도로 두면 빠름)
SNR_MAX_PRODUCTS=0

# 자동 동기화 주기(시간). 0이면 끔
SYNC_INTERVAL_HOURS=12
